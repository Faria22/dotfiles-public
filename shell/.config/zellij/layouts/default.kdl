layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
                format_left   "{mode}#[bg=#313131] {tabs}"
                format_center ""
                format_right  "#[bg=#313131,fg=#babcbc] #[bg=#313131,fg=#babcbc]{session} "
                format_space  "#[bg=#313131]"
                format_hide_on_overlength "true"
                format_precedence "crl"

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#6C7086]{char}"
                border_position "top"

                mode_normal        "#[bg=#c1d041,fg=#313131,bold] NORMAL#[bg=#313131,fg=#c1d041]"
                mode_locked        "#[bg=#4c4c4c,fg=#babcbc,bold] LOCKED #[bg=#313130,fg=#4c4c4c]"
                mode_resize        "#[bg=#3159f5,fg=#313131,bold] RESIZE#[bg=#313131,fg=#3159f5]"
                mode_pane          "#[bg=#3159f5,fg=#313131,bold] PANE#[bg=#313131,fg=#3159f5]"
                mode_tab           "#[bg=#3159f5,fg=#313131,bold] TAB#[bg=#313131,fg=#3159f5]"
                mode_scroll        "#[bg=#3159f5,fg=#313131,bold] SCROLL#[bg=#313131,fg=#3159f5]"
                mode_enter_search  "#[bg=#3159f5,fg=#313131,bold] ENT-SEARCH#[bg=#313131,fg=#3159f5]"
                mode_search        "#[bg=#3159f5,fg=#313131,bold] SEARCHARCH#[bg=#313131,fg=#3159f5]"
                mode_rename_tab    "#[bg=#3159f5,fg=#313131,bold] RENAME-TAB#[bg=#313131,fg=#3159f5]"
                mode_rename_pane   "#[bg=#3159f5,fg=#313131,bold] RENAME-PANE#[bg=#313131,fg=#3159f5]"
                mode_session       "#[bg=#3159f5,fg=#313131,bold] SESSION#[bg=#313131,fg=#3159f5]"
                mode_move          "#[bg=#3159f5,fg=#313131,bold] MOVE#[bg=#313131,fg=#3159f5]"
                mode_prompt        "#[bg=#3159f5,fg=#313131,bold] PROMPT#[bg=#313131,fg=#3159f5]"
                mode_tmux          "#[bg=#d3573b,fg=#313131,bold] TMUX#[bg=#313131,fg=#d3573b]"

                // formatting for inactive tabs
                tab_normal              "#[bg=#313131,fg=#f9de8a]#[bg=#f9de8a,fg=#1e2030,bold]{index} #[bg=#4c4c4c,fg=#f9de8a,bold] {name}{floating_indicator}#[bg=#313131,fg=#4c4c4c,bold]"
                tab_normal_fullscreen   "#[bg=#313131,fg=#f9de8a]#[bg=#f9de8a,fg=#1e2030,bold]{index} #[bg=#4c4c4c,fg=#f9de8a,bold] {name}{fullscreen_indicator}#[bg=#313131,fg=#4c4c4c,bold]"
                tab_normal_sync         "#[bg=#313131,fg=#f9de8a]#[bg=#f9de8a,fg=#1e2030,bold]{index} #[bg=#4c4c4c,fg=#f9de8a,bold] {name}{sync_indicator}#[bg=#313131,fg=#4c4c4c,bold]"

                // formatting for the current active tab
                tab_active              "#[bg=#313131,fg=#89e2e5]#[bg=#89e2e5,fg=#1e2030,bold]{index} #[bg=#4c4c4c,fg=#89e2e5,bold] {name}{floating_indicator}#[bg=#313131,fg=#4c4c4c,bold]"
                tab_active_fullscreen   "#[bg=#313131,fg=#89e2e5]#[bg=#89e2e5,fg=#1e2030,bold]{index} #[bg=#4c4c4c,fg=#89e2e5,bold] {name}{fullscreen_indicator}#[bg=#313131,fg=#4c4c4c,bold]"
                tab_active_sync         "#[bg=#313131,fg=#89e2e5]#[bg=#89e2e5,fg=#1e2030,bold]{index} #[bg=#4c4c4c,fg=#89e2e5,bold] {name}{sync_indicator}#[bg=#313131,fg=#4c4c4c,bold]"

                // separator between the tabs
                tab_separator           "#[bg=#313131] "

                // indicators
                tab_sync_indicator       " "
                tab_fullscreen_indicator " 󰊓"
                tab_floating_indicator   " 󰹙"
            }
        }
        children
    }
}
